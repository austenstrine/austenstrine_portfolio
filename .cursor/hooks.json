{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-start.sh",
        "timeout": 90
      }
    ],
    "subagentStart": [
      {
        "command": ".cursor/hooks/subagent-start-watchdog.sh",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/post-tool-watchdog.sh",
        "matcher": "Task",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/post-tool-admin-crm.sh",
        "matcher": "Write|StrReplace|Edit",
        "timeout": 5
      }
    ]
  }
}
