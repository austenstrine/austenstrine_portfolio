# Project map for dssh (developers-sugary-shell-helper).
#
# dssh does not ship with names like backend, frontend, or proxy.
# This file invents those shorthand names and points each one at something
# in this repo: usually a directory with a Dockerfile. Host-only scripts
# attach to an action with <target>_<action>_local.
#
# Required for each target:
#   <target>=<app directory>
#
# Optional overrides:
#   <target>_dockerfile=<custom Dockerfile path>
#   <target>_context=<custom Docker build context>
#   <target>_image=<custom image name>
#   <target>_name=<custom container app name>  (must match compose on live)
#   <target>_service=<compose service name on live>
#   <target>_aliases=<comma-separated alternate names>
#   <target>_user=<container user; default is the host uid:gid>
#   <target>_workdir=<custom container workdir>

# Registered targets (order used for alias resolution / discovery).
dssh_targets=backend,frontend,crm,proxy,cdn

# Mode: auto|live|local (or export DSSH_MODE).
# auto = live when any dssh_live_detect_targets container has a compose label.
# On the production EC2 box, set live so a compose-down cannot
# flip dssh back into local npm-dev docker-run against live names:
#   dssh_mode=live
# dssh_mode=auto

# Live compose overlay (relative to project root unless absolute).
dssh_live_compose_file=docker-compose.yml
dssh_live_compose_prod_file=docker-compose.prod.yml
dssh_live_container_prefix=portfolio-
dssh_live_detect_targets=backend,frontend,proxy
dssh_live_app_services=cdn,api,web,crm,nginx
dssh_live_infra_services=postgres,redis,opensearch
dssh_live_health_containers=portfolio-postgres,portfolio-redis,portfolio-opensearch,portfolio-cdn,portfolio-api,portfolio-web,portfolio-crm,portfolio-proxy
dssh_live_health_url=https://127.0.0.1/api/health
dssh_live_health_url_http=http://127.0.0.1/api/health
dssh_live_health_exec_container=portfolio-api
dssh_live_health_exec_url=http://127.0.0.1:4000/api/health
dssh_live_migrate_service=api
dssh_live_migrate_cmd='npx prisma migrate deploy --schema apps/api/prisma/schema.prisma'
dssh_migrate_target=backend

# Optional global actions (any dssh_<name>_local becomes `dssh <name>`):
#   dssh_stop_local=<host command>   (LOCAL only; live ignores this)
#   dssh_status_local=<host command>
#   dssh_mailtest_local=<host command>
#   dssh_publish_local=<host command>
#     Required for `dssh publish` — rolling deploy on this host.
#   dssh_launch_local=<host command>
#     Local stack bring-up: 6 Terminal tabs via port-broadcast (rlog/proxy/cdn/
#     backend/frontend/crm). Prefer `dssh launch` over calling the launcher by hand.
#   dssh_land_local=<host command>
#     Opposite of launch: stop rlog + app containers + compose infra + hop listeners.
#
# Resource logger (`dssh rlog`):
#   dssh_rlog_containers=<comma-separated target aliases>
#   dssh_rlog_interval=<seconds>   (default 1)
#   dssh_rlog_dir=<path>
#   dssh_rlog_history_max=<bytes before history-TIMESTAMP.log rotation>
#   dssh_rlog_history_keep=<uncompressed rotated files to keep; older are xz -9e>
#   dssh_rlog_archive_max=<max bytes for history.log + rotated/compressed archives>
#   `dssh logs rlog` → less +F on history.log (scrollable live follow; Ctrl-C scroll, F resume)
#   dssh_gpus=auto|off            (auto: --gpus all when NVIDIA Docker works)
#
# Remote file edit (`dssh rnano <alias>`): ssh -t host nano path.
# Put real hosts/keys in .dsshrc.local (gitignored). See .dsshrc.example.
# Default key is ~/.ssh/id_ed25519 (private key — not .pub).
# When <alias>_repo is set, rnano soft-runs dssh_env_backup_relpath after nano.

# LOCAL stop only. On live, `dssh stop` refuses unless --hard; use
# `dssh backend stop` for one service.
dssh_stop_local="ids=\$(docker ps -aq --filter label=dssh.image); if [[ -n \"\$ids\" ]]; then docker rm -f \$ids; fi; docker compose --profile dashboards stop postgres redis opensearch opensearch-dashboards; echo 'Stopped dssh app containers and compose infra services.'"
dssh_mailtest_local="\"$script_dir/dssh\" backend mailtest"
dssh_publish_local="./ops/deploy/live.sh"
# Local stack: Ptyxis/Terminal 6-tab port-broadcast + agent port map.
# See docs/port-broadcast.md. Map → Project internal/port-broadcast-stack-map.md
# (and ops/diagnostics/port-broadcast-stack-map.md, gitignored).
dssh_launch_local="./scripts/dssh-launch"
dssh_land_local="./scripts/dssh-land"
dssh_env_backup_relpath=ops/tooling/env-backup.sh
dssh_rlog_containers=backend,frontend,crm,proxy,cdn
dssh_rlog_dir=./ops/diagnostics

# Nest API — container name matches docker-compose.prod.yml (portfolio-api)
backend=./apps/api
backend_aliases=api
backend_service=api
backend_image=portfolio-api
backend_name=portfolio-api
backend_start_local="docker ps -q --filter ancestor=portfolio-api | xargs -r docker rm -f >/dev/null 2>&1 || true; docker compose --profile dashboards up -d postgres redis opensearch opensearch-dashboards"
backend_start="npm run prisma:generate -w apps/api && npm run dev -w apps/api"
# start/restart detach by default in dssh; follow with `dssh logs backend`.
# Set =0 only for intentional foreground attach (holds docker flock until exit).
backend_migrate_local="docker compose up -d postgres"
backend_migrate="npm run prisma:migrate -w apps/api -- && npm run prisma:seed -w apps/api"
# start/restart preflight (dssh): detect exit 0 = in sync; non-zero → prompt → apply on y
backend_start_preflight_detect="docker compose up -d postgres >/dev/null && npx prisma migrate status --schema apps/api/prisma/schema.prisma"
backend_start_preflight_apply="\"$tool_bin\" backend migrate"
backend_start_preflight_prompt='Detected unapplied migrations. Run dssh backend migrate now? (y/N)'
backend_start_preflight_timeout=5
backend_start_preflight_default=N
backend_reindex_local="docker compose up -d postgres opensearch"
backend_reindex="npx ts-node --transpile-only apps/api/scripts/reindex-catalog.ts"
backend_mailtest="npx ts-node --transpile-only apps/api/scripts/send-test-email.ts"
backend_mailtest_attach=0

# Next.js app — portfolio-web
frontend=./apps/web
frontend_aliases=web
frontend_service=web
frontend_image=portfolio-web
frontend_name=portfolio-web
frontend_start="npm run dev -w apps/web"

# Admin CRM Next.js app — portfolio-crm (dark side-nav; separate UX)
crm=./apps/crm
crm_service=crm
crm_image=portfolio-crm
crm_name=portfolio-crm
crm_start="npm run dev -w apps/crm"

# Local TLS + nginx. Live compose service is nginx → portfolio-proxy.
proxy=./ops/nginx
proxy_aliases=nginx
proxy_service=nginx
proxy_image=portfolio-proxy
proxy_name=portfolio-proxy
proxy_context=./ops/nginx
# nginx binds 80/443, which needs root in this image.
proxy_user=root
proxy_mount_node_modules=0
proxy_start_local="./ops/nginx/init-local-tls.sh"
proxy_start="nginx -c /app/nginx.conf -g 'daemon off;'"

# Go CDN — github.com/austenstrine/golang-image-cdn via ops/cdn/ensure-source.sh
# (init-local clones into ops/cdn/src). Live compose service cdn → portfolio-cdn.
# Live: TLS on nginx (cdn.austenstrine.dev); :8088 stays internal. CloudFront
# optional later; for now self-host on the EC2 box.
cdn=./ops/cdn
cdn_service=cdn
cdn_image=portfolio-cdn
cdn_name=portfolio-cdn
cdn_context=./ops/cdn
cdn_mount_node_modules=0
cdn_start_local="./ops/cdn/init-local.sh"
cdn_start=/usr/local/bin/cdn
cdn_purge_local="./ops/cdn/purge.sh"
