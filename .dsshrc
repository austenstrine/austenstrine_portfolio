# Project map for dssh.

dssh_stop_local="ids=\$(docker ps -aq --filter label=dssh.image); if [[ -n \"\$ids\" ]]; then docker rm -f \$ids; fi; echo 'Stopped dssh app containers.'"
dssh_rlog_containers=backend,frontend,proxy

# Nest API (health only; no Postgres, Redis, or OpenSearch)
backend=./apps/api
backend_image=portfolio-api
backend_start="npm run dev -w apps/api"
backend_start_detached=1

# Next.js app
frontend=./apps/web
frontend_image=portfolio-web
frontend_start="npm run dev -w apps/web"
frontend_start_detached=1

# Local TLS + nginx.
proxy=./ops/nginx
proxy_image=portfolio-proxy
proxy_context=./ops/nginx
proxy_user=root
proxy_mount_node_modules=0
proxy_start_local="./ops/nginx/init-local-tls.sh"
proxy_start="nginx -c /app/nginx.conf -g 'daemon off;'"
proxy_start_detached=1
