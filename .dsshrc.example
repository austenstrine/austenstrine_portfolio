# Example / template for dssh project map + remote aliases.
# Copy values you need into .dsshrc (or start from the repo .dsshrc).
# Do not put real production hosts, keys, or secrets in committed files.
#
# Full schema: see developers-sugary-shell-helper examples/dsshrc.example

# Mode on the production box:
# dssh_mode=live

# Live stack (compose prod) — all names come from here, not the tool:
# dssh_targets=backend,frontend,proxy,cdn
# dssh_live_detect_targets=backend,frontend,proxy
# dssh_live_app_services=cdn,api,web,nginx
# dssh_live_infra_services=postgres,redis,opensearch
# dssh_live_container_prefix=portfolio-
# dssh_live_health_url=https://127.0.0.1/api/health
# dssh_live_health_url_http=http://127.0.0.1/api/health
# dssh_live_health_exec_container=portfolio-api
# dssh_live_health_exec_url=http://127.0.0.1:4000/api/health
# dssh_live_migrate_service=api
# dssh_live_migrate_cmd='npx prisma migrate deploy --schema apps/api/prisma/schema.prisma'
# dssh_publish_local=./ops/deploy/live.sh
# Local 6-tab stack (port-broadcast): `dssh launch` → scripts/dssh-launch
# dssh_launch_local=./scripts/dssh-launch
# Opposite of launch: `dssh land` → scripts/dssh-land
# dssh_land_local=./scripts/dssh-land
# dssh_env_backup_relpath=ops/tooling/env-backup.sh
#
# Optional backend start/restart migration preflight (requires dssh with
# <target>_start_preflight_* support):
# backend_start_preflight_detect="docker compose up -d postgres >/dev/null && npx prisma migrate status --schema apps/api/prisma/schema.prisma"
# backend_start_preflight_apply="\"$tool_bin\" backend migrate"
# backend_start_preflight_prompt='Detected unapplied migrations. Run dssh backend migrate now? (y/N)'
# backend_start_preflight_timeout=5
# backend_start_preflight_default=N

# Remote file aliases for `dssh rnano <alias>` — put real hosts in .dsshrc.local
# (gitignored), not in committed .dsshrc:
#   <alias>_host=user@host
#   <alias>_path=/absolute/path/to/file
#   <alias>_key=~/.ssh/id_ed25519          # PRIVATE key; optional (this is default)
#   <alias>_repo=/absolute/path/to/checkout # optional; post-edit env backup
#
# Example (.dsshrc.local):
#   prod_env_host=ubuntu@ec2-….compute.amazonaws.com
#   prod_env_path=/var/www/html/.env
#   prod_env_key=~/.ssh/id_ed25519
#   prod_env_repo=/var/www/html

# Encrypted .env backup (via linux-gdrive-dotenv-backup-recovery):
#   docs/tooling/env-backup.md
#   ./ops/tooling/env-backup.sh backup   # portfolio wrapper → extracted CLI
