# Shared
NODE_ENV=development

# API
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio
REDIS_URL=redis://localhost:6379
OPENSEARCH_NODE=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=
OPENSEARCH_TLS_REJECT_UNAUTHORIZED=false

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
# Next SSR fetch origin. Required when NEXT_PUBLIC_API_BASE_URL is local HTTPS
# (Node will not trust the nginx cert). Browser requests still use NEXT_PUBLIC_*.
API_INTERNAL_BASE_URL=http://127.0.0.1:4000/api
# Local CDN (production: https://cdn.austenstrine.dev). Browser assets use this.
NEXT_PUBLIC_CDN_URL=https://cdn.local.austenstrine.dev
CDN_PUBLIC_URL=https://cdn.local.austenstrine.dev
CDN_LISTEN=:8088
CDN_PULL_ORIGIN=http://127.0.0.1:3000
CDN_TOKEN=local-cdn-dev
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY= (api)
# STRIPE_WEBHOOK_SECRET= (api)
# PLATFORM_FEE_BPS=1000
# PLATFORM_FLAT_FEE_CENTS=0

# Auth: JWT signing secrets (generate with `openssl rand -hex 32`, keep distinct)
JWT_ACCESS_SECRET=
JWT_PENDING_SECRET=
OTP_PEPPER=

# Auth: cookies
COOKIE_DOMAIN=
WEB_URL=http://localhost:3000

# Auth: Google OAuth (create credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Auth: outbound email via Gmail SMTP (or any SMTP provider).
# SMTP_USER is the mailbox you sign into (e.g. your Gmail address).
# SMTP_PASS is a Google App Password; spaces are optional.
# SMTP_FROM must be a "Send mail as" address on that mailbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Austen Strine <admin@austenstrine.dev>
MAIL_TO=admin@austenstrine.dev
