# Shared
NODE_ENV=development

# API
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio
REDIS_URL=redis://localhost:6379
OPENSEARCH_NODE=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=
OPENSEARCH_TLS_REJECT_UNAUTHORIZED=false

# Web
# Live shopper "pardon our dust" banner (server-read; Place et Marque).
# Shows on non-local hosts unless maintenance_banner_bypass=true.
# Leave unset/false on live so the banner stays visible.
# Whitespace-only message counts as empty → stock copy.
# maintenance_banner_bypass=true
# maintenance_banner_message=

# TLS (live.sh → ops/deploy/ensure-tls.sh). Used only when obtaining/expanding
# the Let's Encrypt cert for austenstrine.dev + www + cdn.
# CERTBOT_EMAIL=you@example.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
# Next SSR fetch origin. Required when NEXT_PUBLIC_API_BASE_URL is local HTTPS
# (Node will not trust the nginx cert). Browser requests still use NEXT_PUBLIC_*.
API_INTERNAL_BASE_URL=http://127.0.0.1:4000/api
# CDN — golang-image-cdn (https://github.com/austenstrine/golang-image-cdn)
# cloned into ops/cdn/src by ensure-source.sh; local behind nginx (cdn.local…);
# live self-hosts as portfolio-cdn at https://cdn.austenstrine.dev (no public
# :8088). CloudFront+S3 optional later.
NEXT_PUBLIC_CDN_URL=https://cdn.local.austenstrine.dev
CDN_PUBLIC_URL=https://cdn.local.austenstrine.dev
CDN_LISTEN=:8088
# Local: Next on the host. Live compose overrides to http://web:3000.
CDN_PULL_ORIGIN=http://127.0.0.1:3000
# Local-only placeholder. Production MUST set a strong random value
# (e.g. `openssl rand -hex 32`). Empty or `local-cdn-dev` refuse to boot
# when NODE_ENV=production (Go CDN + Nest API).
CDN_TOKEN=local-cdn-dev
# API → CDN. Local host network. Live compose defaults to http://cdn:8088.
CDN_INTERNAL_URL=http://127.0.0.1:8088
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY= (api)
# STRIPE_WEBHOOK_SECRET= (api)
# PLATFORM_FEE_BPS=1000
# PLATFORM_FLAT_FEE_CENTS=0

# Auth: JWT signing secrets (generate with `openssl rand -hex 32`, keep distinct)
JWT_ACCESS_SECRET=
JWT_PENDING_SECRET=
OTP_PEPPER=

# Auth: supervendor admin password hash (argon2id). Copied from an existing
# User.passwordHash for admin@austenstrine.dev so ensureSupervendor can
# recreate/bootstrap that login. Leave unset if you have no hash yet.
# SUPERVENDOR_PASSWORD_HASH=

# Auth: cookies
# Share session cookies across www / crm (and local.* / local.crm.*) hosts:
#   COOKIE_DOMAIN=.austenstrine.dev
COOKIE_DOMAIN=
# CORS + OAuth redirect origin. Required when NODE_ENV=production (API
# fails closed on boot if missing). Local default is fine for development.
# Production canonical host is www:
#   WEB_URL=https://www.austenstrine.dev
WEB_URL=http://localhost:3000
# Admin CRM browser origin (CORS + CrmOriginGuard). Required in production.
# Local TLS via nginx:
#   CRM_URL=https://local.crm.austenstrine.dev
# Production:
#   CRM_URL=https://crm.austenstrine.dev
CRM_URL=http://localhost:3001

# Auth: Google OAuth (create credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# Production:
#   GOOGLE_CALLBACK_URL=https://www.austenstrine.dev/api/auth/google/callback


# Auth: outbound email via Gmail SMTP (or any SMTP provider).
# SMTP_USER is the mailbox you sign into (e.g. your Gmail address).
# SMTP_PASS is a Google App Password; spaces are optional.
# SMTP_FROM must be a "Send mail as" address on that mailbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Austen Strine <admin@austenstrine.dev>
MAIL_TO=admin@austenstrine.dev
