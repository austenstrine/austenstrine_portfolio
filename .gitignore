node_modules/
dist/
.next/
coverage/
.env
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
apps/api/generated/
*.tsbuildinfo

# Local TLS certs generated for dssh/nginx development proxy
ops/nginx/certs/

# CDN disk cache and uploaded origin objects (keep the folders)
ops/cdn/data/cache/**
!ops/cdn/data/cache/.gitkeep
ops/cdn/data/origin/**
!ops/cdn/data/origin/.gitkeep
# Cloned golang-image-cdn checkout (ops/cdn/ensure-source.sh)
ops/cdn/src/

# rlog snapshots, history, pid, and stream files (keep the sampler script)
ops/diagnostics/*
!ops/diagnostics/rlog.sh

# Serializes dssh docker build/stop/run across terminals
.dssh-docker.lock

# Local dssh overrides (prod SSH hosts/keys) — keep .dsshrc committed
.dsshrc.local

# Auto-loaded compose overrides (e.g. crash-recovery host port remaps)
docker-compose.override.yml

# Local env backups from port-recovery / tooling
.env.bak-*
apps/api/.env.bak-*
