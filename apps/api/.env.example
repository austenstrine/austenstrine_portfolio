# Copy to .env and fill in real values. Never commit the real .env file.

# --- Core infra (already used by Prisma/Redis/OpenSearch) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio"
REDIS_URL="redis://localhost:6379"
OPENSEARCH_NODE="http://localhost:9200"
PORT=4000

# --- Auth: JWT signing secrets (use long, random, distinct values) ---
# e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_PENDING_SECRET="replace-with-a-different-long-random-secret"

# --- Auth: OTP hashing pepper (separate from JWT secrets) ---
OTP_PEPPER="replace-with-a-long-random-secret"

# --- Auth: cookies ---
# Leave COOKIE_DOMAIN unset for localhost. Set NODE_ENV=production in real
# deployments so the "secure" cookie flag is enforced.
COOKIE_DOMAIN=
NODE_ENV=development

# --- Auth: Google OAuth (create credentials in Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# --- Auth: outbound email (any SMTP provider works: Gmail app password,
# Brevo, Mailgun, Postmark, Resend SMTP, etc. No AWS SES required) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Austen Strine <no-reply@austenstrine.dev>"

# --- Frontend URL, used for CORS + OAuth redirect target ---
WEB_URL="http://localhost:3000"
