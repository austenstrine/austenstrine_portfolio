# Copy to .env and fill in real values. Never commit the real .env file.

# --- Core infra (already used by Prisma/Redis/OpenSearch) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio"
REDIS_URL="redis://localhost:6379"
OPENSEARCH_NODE="https://localhost:9200"
OPENSEARCH_USERNAME="admin"
OPENSEARCH_PASSWORD=
OPENSEARCH_TLS_REJECT_UNAUTHORIZED="false"
PORT=4000

# --- Auth: JWT signing secrets (use long, random, distinct values) ---
# e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_PENDING_SECRET="replace-with-a-different-long-random-secret"

# --- Auth: OTP hashing pepper (separate from JWT secrets) ---
OTP_PEPPER="replace-with-a-long-random-secret"

# --- Auth: supervendor admin password hash (argon2id) ---
# Copied from User.passwordHash for the reserved supervendor admin email.
# Used by ensureSupervendor to create/bootstrap that login. Leave unset if none.
# SUPERVENDOR_PASSWORD_HASH=

# --- Auth: cookies ---
# Leave COOKIE_DOMAIN unset for localhost. Set NODE_ENV=production in real
# deployments so the "secure" cookie flag is enforced.
COOKIE_DOMAIN=
NODE_ENV=development

# --- API rate limit (Nest ThrottlerGuard default, per route + client IP) ---
# OTP / login / register / forgot / reset keep tighter @Throttle on those handlers.
# Default when unset: 600 if NODE_ENV!=production, else 120.
# TRUST_PROXY defaults to 1 hop (nginx). Set 0 only if the API is not behind a proxy.
# THROTTLE_LIMIT=600
# TRUST_PROXY=1

# --- Auth: Google OAuth (create credentials in Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# --- Auth: outbound email via Gmail SMTP (or any SMTP provider) ---
# SMTP_USER is the mailbox you sign into. SMTP_PASS is a Google App Password.
# SMTP_FROM must be a "Send mail as" address on that mailbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Austen Strine <admin@austenstrine.dev>"
MAIL_TO=admin@austenstrine.dev

# --- Frontend URLs (CORS + OAuth redirect + CRM origin guard) ---
# WEB_URL required when NODE_ENV=production (API fails closed on boot if missing).
# CRM_URL required in production for admin CRM CORS / CrmOriginGuard.
WEB_URL="http://localhost:3000"
CRM_URL="http://localhost:3001"
# Share auth cookies across web + CRM subdomains:
# COOKIE_DOMAIN=".austenstrine.dev"

# --- CDN upload auth (must match golang-image-cdn / compose CDN_TOKEN) ---
# Local placeholder only. Production needs a strong random value
# (e.g. `openssl rand -hex 32`); `local-cdn-dev` is rejected in production.
# Live: Go CDN on-box (portfolio-cdn); CDN_INTERNAL_URL → http://cdn:8088
# via docker-compose.prod.yml. CloudFront optional later.
CDN_TOKEN=local-cdn-dev
CDN_INTERNAL_URL=http://127.0.0.1:8088
CDN_PUBLIC_URL=https://cdn.local.austenstrine.dev

# --- Stripe checkout (test keys are fine for local/dev) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# When Stripe keys are unset, set to 1 so POST /checkout/sessions still
# creates PAID orders (local demo / audit only — never in production).
# CHECKOUT_DEV_BYPASS=1
# Optional Connect return base (defaults to WEB_URL)
# STRIPE_CONNECT_RETURN_URL=http://localhost:3000
# Platform fee bootstrap (applied on first boot / when set)
# PLATFORM_FEE_BPS=1000
# PLATFORM_FLAT_FEE_CENTS=0
