{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db execute --file prisma/drop-unmanaged-tables.sql && prisma migrate dev --skip-seed",
    "prisma:seed": "prisma db seed",
    "reindex": "ts-node --transpile-only scripts/reindex-catalog.ts",
    "seed-sync": "node ../../packages/prisma-seed-migration-sync/dist/cli.js sync --dir prisma/seed-data",
    "seed-sync:dry": "node ../../packages/prisma-seed-migration-sync/dist/cli.js sync --dir prisma/seed-data --dry-run",
    "seed-sync:validate": "node ../../packages/prisma-seed-migration-sync/dist/cli.js validate --dir prisma/seed-data",
    "seed-batch": "ts-node --transpile-only prisma/generate-catalog-seed-batch.ts",
    "mail:test": "ts-node --transpile-only scripts/send-test-email.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.2",
    "@nestjs/core": "^10.4.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@opensearch-project/opensearch": "^2.13.0",
    "@prisma/client": "^5.19.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ioredis": "^5.4.1",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "prisma-seed-migration-sync": "*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^17.7.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.16.2",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "prisma": "^5.19.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
