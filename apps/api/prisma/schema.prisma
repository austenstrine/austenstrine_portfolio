generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  summary     String
  description String?
  repoUrl     String?
  liveUrl     String?
  tags        String[] @default([])
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([featured])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String?
  googleId            String?   @unique
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  refreshTokens RefreshToken[]
  emailOtps     EmailOtp[]
  vendorMemberships VendorMember[]
  vendorAppPasswordsCreated VendorAppPassword[]
  catalogImportJobs CatalogImportJob[]
  carts Cart[]
  checkouts Checkout[]
  marketplaceOrders MarketplaceOrder[]

  @@index([createdAt])
}

model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  familyId            String
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

enum EmailOtpPurpose {
  EMAIL_VERIFICATION
  LOGIN_2FA
  PASSWORD_RESET
}

model EmailOtp {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    EmailOtpPurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int             @default(0)
  createdAt  DateTime        @default(now())

  @@index([userId, purpose])
}

// --- Marketplace catalog & inventory ---

enum VendorMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum ProductOfferingRole {
  STANDALONE
  PACK
  PIECE
}

enum BrokenPackStatus {
  ACTIVE
  DEPLETED
}

enum InventoryClaimStatus {
  PENDING
  FULFILLED
  RELEASED
}

enum InventoryTrimStrategy {
  WHOLE_UNITS_FIRST
  SMALLEST_REMAINDER_FIRST
  LARGEST_REMAINDER_FIRST
}

enum BreakFeeMode {
  OFF
  PER_PARENT_OPENED
  ONCE_PER_LINE
  PRODUCT_ONCE
}

enum CatalogImportSource {
  UI
  API
}

enum CatalogImportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum CheckoutStatus {
  OPEN
  AWAITING_PAYMENT
  PAID
  FAILED
  EXPIRED
}

enum MarketplaceOrderStatus {
  HOLD
  PAID
  FULFILLING
  SHIPPED
  CANCELLED
}

enum PayoutTrigger {
  ON_PAYMENT
  ON_SHIPMENT
}

enum VendorPayoutStatus {
  PENDING
  READY
  TRANSFERRED
  FAILED
  SKIPPED
}

model Vendor {
  id                          String    @id @default(uuid())
  slug                        String    @unique
  name                        String
  stripeConnectAccountId      String?
  stripeDetailsSubmitted      Boolean   @default(false)
  stripeChargesEnabled        Boolean   @default(false)
  stripePayoutsEnabled        Boolean   @default(false)
  stripeOnboardingCompleteAt  DateTime?
  platformFeeBpsOverride      Int?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  members  VendorMember[]
  products CatalogProduct[]
  appPasswords VendorAppPassword[]
  importJobs CatalogImportJob[]
  offerings ProductOffering[]
  shippingProfiles ShippingProfile[]
  marketplaceOrders MarketplaceOrder[]
  checkoutShipments CheckoutShipment[]
  payouts VendorPayout[]

  @@index([name])
  @@index([stripeConnectAccountId])
}

model PlatformFeeConfig {
  id                 String   @id @default(uuid())
  merchandiseFeeBps  Int      @default(1000)
  flatFeeCents       Int      @default(0)
  currency           String   @default("USD")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model VendorPayout {
  id               String             @id @default(uuid())
  orderId          String             @unique
  order            MarketplaceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId         String
  vendor           Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  checkoutId       String?
  merchandiseCents Int
  shippingCents    Int
  feeCents         Int
  vendorNetCents   Int
  currency         String             @default("USD")
  status           VendorPayoutStatus @default(PENDING)
  trigger          PayoutTrigger
  stripeTransferId String?
  attemptCount     Int                @default(0)
  lastError        String?
  readyAt          DateTime?
  transferredAt    DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([vendorId, status])
  @@index([status, readyAt])
  @@index([checkoutId])
}

model VendorAppPassword {
  id              String    @id @default(uuid())
  vendorId        String
  vendor          Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name            String
  tokenPrefix     String
  secretHash      String    @unique
  createdByUserId String
  createdBy       User      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([vendorId])
  @@index([tokenPrefix])
}

model CatalogImportJob {
  id              String              @id @default(uuid())
  vendorId        String
  vendor          Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdBy       User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  source          CatalogImportSource @default(UI)
  status          CatalogImportStatus @default(PENDING)
  rowCount        Int                 @default(0)
  createdCount    Int                 @default(0)
  updatedCount    Int                 @default(0)
  errorCount      Int                 @default(0)
  errorsJson      Json?
  createdAt       DateTime            @default(now())
  finishedAt      DateTime?

  @@index([vendorId, createdAt])
  @@index([status])
}

model VendorMember {
  id        String           @id @default(uuid())
  vendorId  String
  vendor    Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      VendorMemberRole @default(EDITOR)
  createdAt DateTime         @default(now())

  @@unique([vendorId, userId])
  @@index([userId])
}

model UnitOfMeasure {
  id            String   @id @default(uuid())
  code          String   @unique
  label         String
  /// Logical grouping for conversions, e.g. length, count, volume, weight, area, custom
  dimensionKey  String
  /// Multiply quantity in this UOM by factorToReference to reach the dimension reference unit
  factorToReference Decimal @db.Decimal(24, 8)
  metadata      Json?
  createdAt     DateTime @default(now())

  offerings ProductOffering[]
}

model CatalogCategory {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  parentId  String?
  parent    CatalogCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  CatalogCategory[] @relation("CategoryTree")
  createdAt DateTime @default(now())

  products CatalogProduct[]

  @@index([parentId])
}

model CatalogProduct {
  id          String   @id @default(uuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    CatalogCategory? @relation(fields: [categoryId], references: [id])
  shippingProfileId String?
  shippingProfile   ShippingProfile? @relation(fields: [shippingProfileId], references: [id], onDelete: SetNull)
  slug        String
  title       String
  description String?
  active      Boolean  @default(true)
  /// Legacy; prefer offering inheritQtyToChildren + containment graph
  inventoryFromAllocations Boolean @default(false)
  breakFeeMode BreakFeeMode @default(OFF)
  breakFeeCents Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attributes ProductAttribute[]
  offerings  ProductOffering[]

  @@unique([vendorId, slug])
  @@index([categoryId])
  @@index([shippingProfileId])
  @@index([active])
  @@index([title])
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String
  product   CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
  sortOrder Int      @default(0)

  @@unique([productId, key])
  @@index([productId])
}

model ProductOffering {
  id          String              @id @default(uuid())
  productId   String
  product     CatalogProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Denormalized for vendor-scoped (sku, offeringKey) uniqueness and bulk upsert
  vendorId    String
  vendor      Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sku         String
  /// Importer-controlled stable id; with sku forms the unique offering identity per vendor
  offeringKey String              @default("default")
  uomId       String
  uom         UnitOfMeasure       @relation(fields: [uomId], references: [id])
  role        ProductOfferingRole @default(STANDALONE)
  priceCents  Int
  currency    String              @default("USD")
  /// On-hand count in this offering's UOM (e.g. number of spools). Often 0 for PIECE rows.
  qtyOnHand   Decimal             @default(0) @db.Decimal(24, 8)
  /// Cached unclaimed sellable qty in this offering's UOM (refreshed by inventory service)
  availableQty Decimal            @default(0) @db.Decimal(24, 8)
  /// When false, qtyOnHand is ignored for own-qty availability; inheritance/broken still apply
  tracksOwnQty Boolean            @default(true)
  /// -1 = no auto-break from wholes; >= 0 floor on remaining whole units after auto-break
  minUnbrokenQty Decimal          @default(-1) @db.Decimal(24, 8)
  /// Only wholes above this count enter auto-break / inheritance pool
  breakPoolAboveQty Decimal       @default(0) @db.Decimal(24, 8)
  /// When true, eligible parent wholes count toward child availableQty
  inheritQtyToChildren Boolean    @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  containmentsAsParent OfferingContainment[] @relation("ParentSide")
  containmentsAsChild  OfferingContainment[] @relation("ChildSide")
  brokenPacks      BrokenPack[]
  claims           InventoryClaim[]
  cartLines        CartLine[]
  orderLines       OrderLine[]
  checkoutLines    CheckoutLine[]

  @@unique([productId, uomId, role])
  @@unique([productId, sku, offeringKey])
  @@unique([vendorId, sku, offeringKey])
  @@index([productId])
  @@index([vendorId])
  @@index([role])
  @@index([sku])
}

model OfferingContainment {
  id                 String          @id @default(uuid())
  parentOfferingId   String
  parentOffering     ProductOffering @relation("ParentSide", fields: [parentOfferingId], references: [id], onDelete: Cascade)
  childOfferingId    String
  childOffering      ProductOffering @relation("ChildSide", fields: [childOfferingId], references: [id], onDelete: Cascade)
  /// How much child-UOM quantity one parent unit contains (e.g. 500 ft per spool)
  childQtyPerParent  Decimal         @db.Decimal(24, 8)
  breakFeeCents      Int?
  createdAt          DateTime        @default(now())

  @@unique([parentOfferingId, childOfferingId])
  @@index([childOfferingId])
}

model BrokenPack {
  id              String          @id @default(uuid())
  packOfferingId  String
  packOffering    ProductOffering @relation(fields: [packOfferingId], references: [id], onDelete: Cascade)
  label           String?
  /// Remaining quantity in the linked piece offering's UOM
  remainingQty    Decimal         @db.Decimal(24, 8)
  status          BrokenPackStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  claims InventoryClaim[]

  @@index([packOfferingId, status])
}

model ShippingProfile {
  id              String        @id @default(uuid())
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  code            String
  name            String
  shipsSeparately Boolean       @default(false)
  payoutTrigger   PayoutTrigger @default(ON_PAYMENT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  rates    ShippingRate[]
  products CatalogProduct[]
  checkoutShipments CheckoutShipment[]
  orders   MarketplaceOrder[]

  @@unique([vendorId, code])
  @@index([vendorId])
}

model ShippingRate {
  id               String   @id @default(uuid())
  profileId        String
  profile          ShippingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label            String
  amountCents      Int
  minSubtotalCents Int?
  maxSubtotalCents Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([profileId])
}

model Cart {
  id        String   @id @default(uuid())
  buyerId   String   @unique
  buyer     User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines CartLine[]
}

model CartLine {
  id         String          @id @default(uuid())
  cartId     String
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  offeringId String
  offering   ProductOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  quantity   Decimal         @db.Decimal(24, 8)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([cartId, offeringId])
  @@index([offeringId])
}

model Checkout {
  id                    String         @id @default(uuid())
  buyerId               String
  buyer                 User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  status                CheckoutStatus @default(OPEN)
  stripePaymentIntentId String?        @unique
  currency              String         @default("USD")
  merchandiseCents     Int            @default(0)
  shippingCents         Int            @default(0)
  totalCents            Int            @default(0)
  expiresAt             DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  shipments CheckoutShipment[]
  orders    MarketplaceOrder[]

  @@index([buyerId, createdAt])
  @@index([status, expiresAt])
}

model CheckoutShipment {
  id                String   @id @default(uuid())
  checkoutId        String
  checkout          Checkout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  shippingProfileId String
  shippingProfile   ShippingProfile @relation(fields: [shippingProfileId], references: [id])
  selectedRateId    String?
  selectedRateLabel String?
  shippingCents     Int      @default(0)
  merchandiseCents Int     @default(0)
  /// Shared or per-group ship-to snapshot
  shipName          String?
  shipLine1         String?
  shipLine2         String?
  shipCity          String?
  shipRegion        String?
  shipPostal        String?
  shipCountry       String?  @default("US")
  createdAt         DateTime @default(now())

  lines  CheckoutLine[]
  order  MarketplaceOrder?

  @@index([checkoutId])
  @@index([vendorId])
}

model CheckoutLine {
  id         String           @id @default(uuid())
  shipmentId String
  shipment   CheckoutShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  offeringId String
  offering   ProductOffering  @relation(fields: [offeringId], references: [id])
  quantity   Decimal          @db.Decimal(24, 8)
  unitPriceCents Int
  lineTotalCents Int
  titleSnapshot  String
  skuSnapshot    String
  offeringKeySnapshot String

  @@index([shipmentId])
  @@index([offeringId])
}

model MarketplaceOrder {
  id                 String                 @id @default(uuid())
  orderRef           String                 @unique
  buyerId            String?
  buyer              User?                  @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  vendorId           String?
  vendor             Vendor?                @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  checkoutId         String?
  checkout           Checkout?              @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  checkoutShipmentId String?                @unique
  checkoutShipment   CheckoutShipment?      @relation(fields: [checkoutShipmentId], references: [id], onDelete: SetNull)
  shippingProfileId  String?
  shippingProfile    ShippingProfile?       @relation(fields: [shippingProfileId], references: [id], onDelete: SetNull)
  status             MarketplaceOrderStatus @default(HOLD)
  currency           String                 @default("USD")
  merchandiseCents  Int                    @default(0)
  shippingCents      Int                    @default(0)
  totalCents         Int                    @default(0)
  shippingLabel      String?
  shipName           String?
  shipLine1          String?
  shipLine2          String?
  shipCity           String?
  shipRegion         String?
  shipPostal         String?
  shipCountry        String?
  stripeTransferId   String?
  feeCents           Int                    @default(0)
  vendorNetCents     Int                    @default(0)
  payoutTrigger      PayoutTrigger          @default(ON_PAYMENT)
  shippedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  claims InventoryClaim[]
  lines  OrderLine[]
  payout VendorPayout?

  @@index([buyerId, createdAt])
  @@index([vendorId, status])
  @@index([checkoutId])
}

model OrderLine {
  id                  String          @id @default(uuid())
  orderId             String
  order               MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offeringId          String
  offering            ProductOffering @relation(fields: [offeringId], references: [id])
  quantity            Decimal         @db.Decimal(24, 8)
  unitPriceCents      Int
  lineTotalCents      Int
  titleSnapshot       String
  skuSnapshot         String
  offeringKeySnapshot String
  claimId             String?         @unique
  claim               InventoryClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([offeringId])
}

model InventoryClaim {
  id                 String               @id @default(uuid())
  orderId            String
  order              MarketplaceOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offeringId         String
  offering           ProductOffering      @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  brokenPackId       String?
  brokenPack         BrokenPack?          @relation(fields: [brokenPackId], references: [id])
  /// Quantity claimed in the offering's UOM
  quantity           Decimal              @db.Decimal(24, 8)
  /// Same claim normalized to piece UOM when applicable
  quantityInPieceUom Decimal?             @db.Decimal(24, 8)
  status             InventoryClaimStatus @default(PENDING)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  orderLine OrderLine?

  @@index([orderId])
  @@index([offeringId, status])
  @@index([brokenPackId])
}

/// Soft-deleted catalog snapshots (no FKs into live tables). Pruned after 6 months.
model ArchivedCatalogProduct {
  id                       String       @id @default(uuid())
  archiveBatchId           String
  archivedAt               DateTime     @default(now())
  originalId               String
  vendorId                 String
  vendorSlug               String
  categoryId               String?
  categorySlug             String?
  slug                     String
  title                    String
  description              String?
  active                   Boolean
  inventoryFromAllocations Boolean
  breakFeeMode             BreakFeeMode
  breakFeeCents            Int
  originalCreatedAt        DateTime
  originalUpdatedAt        DateTime

  @@index([archivedAt])
  @@index([archiveBatchId])
  @@index([vendorId, slug])
  @@index([originalId])
}

model ArchivedProductAttribute {
  id                String   @id @default(uuid())
  archiveBatchId    String
  archivedAt        DateTime @default(now())
  originalId        String
  originalProductId String
  key               String
  value             String
  sortOrder         Int

  @@index([archivedAt])
  @@index([archiveBatchId])
  @@index([originalProductId])
}

model ArchivedProductOffering {
  id                   String              @id @default(uuid())
  archiveBatchId       String
  archivedAt           DateTime            @default(now())
  originalId           String
  originalProductId    String
  vendorId             String
  sku                  String
  offeringKey          String
  uomId                String
  uomCode              String
  role                 ProductOfferingRole
  priceCents           Int
  currency             String
  qtyOnHand            Decimal             @db.Decimal(24, 8)
  availableQty         Decimal             @db.Decimal(24, 8)
  tracksOwnQty         Boolean
  minUnbrokenQty       Decimal             @db.Decimal(24, 8)
  breakPoolAboveQty    Decimal             @db.Decimal(24, 8)
  inheritQtyToChildren Boolean
  originalCreatedAt    DateTime
  originalUpdatedAt    DateTime

  @@index([archivedAt])
  @@index([archiveBatchId])
  @@index([vendorId, sku, offeringKey])
  @@index([originalId])
}

model ArchivedOfferingContainment {
  id                     String   @id @default(uuid())
  archiveBatchId         String
  archivedAt             DateTime @default(now())
  originalId             String
  originalParentOfferingId String
  originalChildOfferingId  String
  parentSku              String
  parentOfferingKey      String
  childSku               String
  childOfferingKey       String
  childQtyPerParent      Decimal  @db.Decimal(24, 8)
  breakFeeCents          Int?
  originalCreatedAt      DateTime

  @@index([archivedAt])
  @@index([archiveBatchId])
}

model ArchivedBrokenPack {
  id                   String           @id @default(uuid())
  archiveBatchId       String
  archivedAt           DateTime         @default(now())
  originalId           String
  originalPackOfferingId String
  packSku              String
  packOfferingKey      String
  label                String?
  remainingQty         Decimal          @db.Decimal(24, 8)
  status               BrokenPackStatus
  originalCreatedAt    DateTime
  originalUpdatedAt    DateTime

  @@index([archivedAt])
  @@index([archiveBatchId])
}

