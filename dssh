#!/usr/bin/env bash
# Thin wrapper: project keeps .dsshrc; CLI lives in developers-sugary-shell-helper.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DSSH_PROJECT_ROOT="$ROOT"
THIS="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s\n' "${BASH_SOURCE[0]}")"

resolve_dssh() {
  local candidate path_dssh resolved
  if [[ -n "${DSSH_BIN-}" ]]; then
    if [[ -x "$DSSH_BIN" ]]; then
      printf '%s\n' "$DSSH_BIN"
      return 0
    fi
    echo "dssh: DSSH_BIN is set but not executable: $DSSH_BIN" >&2
    return 1
  fi

  for candidate in \
    "$ROOT/../developers-sugary-shell-helper/bin/dssh" \
    "$HOME/.local/share/developers-sugary-shell-helper/bin/dssh" \
    "$HOME/src/developers-sugary-shell-helper/bin/dssh" \
    "$HOME/code/developers-sugary-shell-helper/bin/dssh"
  do
    if [[ -x "$candidate" ]]; then
      resolved="$(readlink -f "$candidate" 2>/dev/null || printf '%s\n' "$candidate")"
      if [[ "$resolved" != "$THIS" ]]; then
        printf '%s\n' "$candidate"
        return 0
      fi
    fi
  done

  path_dssh="$(type -P dssh 2>/dev/null || true)"
  if [[ -n "$path_dssh" ]]; then
    resolved="$(readlink -f "$path_dssh" 2>/dev/null || printf '%s\n' "$path_dssh")"
    if [[ "$resolved" != "$THIS" ]]; then
      printf '%s\n' "$path_dssh"
      return 0
    fi
  fi

  return 1
}

if ! real="$(resolve_dssh)"; then
  cat >&2 <<'EOF'
dssh: developers-sugary-shell-helper not found.

  git clone https://github.com/austenstrine/developers-sugary-shell-helper.git
  cd developers-sugary-shell-helper && ./install.sh

  Or set DSSH_BIN to that repo's bin/dssh.
EOF
  exit 127
fi

exec "$real" "$@"
