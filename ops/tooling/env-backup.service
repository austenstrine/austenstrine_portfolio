[Unit]
Description=Encrypted .env backup to Google Drive (restic)
After=network-online.target

[Service]
Type=oneshot
# Install: copy/symlink this unit, set ExecStart to the checkout path, then
#   systemctl --user daemon-reload && systemctl --user enable --now env-backup.timer
# Example (edit path for the host):
# ExecStart=%h/Development/austenstrine_portfolio/ops/tooling/env-backup.sh backup
ExecStart=%h/bin/env-backup.sh backup
Nice=10
