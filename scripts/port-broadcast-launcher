#!/usr/bin/env bash
# port-broadcast-launcher — N Cursor integrated-terminal tabs of port-broadcast-shell
#
# Uses the terminal already inside Cursor (editor/panel tabs) — not a second OS
# terminal app (GNOME Terminal / Wayland). Austen watches Cursor; agents nc ports.
#
# How tabs open:
#   Cursor/VS Code tasks with presentation.panel=dedicated (see .vscode/tasks.json).
#   This script validates ports, prints the nc map, and points at the task labels.
#
# Usage:
#   ./scripts/port-broadcast-launcher --smoke
#   ./scripts/port-broadcast-launcher --tabs 6 --confirm
#   ./scripts/port-broadcast-launcher --dry-run --tabs 6 --confirm
#
# Then in Cursor: Command Palette → "Tasks: Run Task" → the printed label.
# Agent attach: nc 127.0.0.1 4591 … 4596

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SHELL_HELPER="${ROOT}/scripts/port-broadcast-shell"
BIND="${PORT_BROADCAST_BIND:-127.0.0.1}"
BASE_PORT="${PORT_BROADCAST_BASE_PORT:-4591}"
TABS="${PORT_BROADCAST_TABS:-6}"
MAX_TABS=8
CONFIRM=0
DRY_RUN=0
SMOKE=0

usage() {
	cat <<'EOF'
Usage: port-broadcast-launcher [options]

  Prepare N port-broadcast tabs in Cursor's integrated terminal (not GNOME).
  Prints the port map and the Tasks: Run Task label to open.

Options:
  -n, --tabs N          Tab count (default: 6, or PORT_BROADCAST_TABS; max 8)
  -p, --base-port PORT  First listen port (default: 4591; tasks ship for 4591–4596)
  -b, --bind ADDR       Listen address (default: 127.0.0.1, or PORT_BROADCAST_BIND)
      --confirm         Required when tabs > 1
      --smoke           Point at 1-tab smoke task (implies --tabs 1)
      --dry-run         Print port map + task label only (same as default; no side effects)
  -h, --help            Show this help

Open tabs (in Cursor — the regular IDE terminal):
  Command Palette → "Tasks: Run Task" → port-broadcast: smoke
  Command Palette → "Tasks: Run Task" → port-broadcast: 6 tabs

Agent attach:
  nc 127.0.0.1 4591
  …

Note: shipped tasks bind ports 4591–4596. --base-port only remaps the printed
nc cheat-sheet; retarget tasks if you shift the range.
EOF
}

die() {
	echo "port-broadcast-launcher: $*" >&2
	exit 1
}

while [[ $# -gt 0 ]]; do
	case "$1" in
		-n|--tabs)
			TABS="${2:?missing tab count}"
			shift 2
			;;
		-p|--base-port)
			BASE_PORT="${2:?missing base port}"
			shift 2
			;;
		-b|--bind)
			BIND="${2:?missing bind address}"
			shift 2
			;;
		--confirm)
			CONFIRM=1
			shift
			;;
		--smoke)
			SMOKE=1
			shift
			;;
		--dry-run)
			DRY_RUN=1
			shift
			;;
		-h|--help)
			usage
			exit 0
			;;
		--)
			die "per-tab -- command is not wired through Cursor tasks yet; edit .vscode/tasks.json or run port-broadcast-shell directly in a Cursor terminal"
			;;
		-*)
			die "unknown option: $1"
			;;
		*)
			die "unexpected argument: $1"
			;;
	esac
done

if ((SMOKE)); then
	TABS=1
fi

if ! [[ "$TABS" =~ ^[0-9]+$ ]] || ((TABS < 1 || TABS > MAX_TABS)); then
	die "tabs must be 1..${MAX_TABS} (got: $TABS)"
fi

if ! [[ "$BASE_PORT" =~ ^[0-9]+$ ]] || ((BASE_PORT < 1 || BASE_PORT > 65535)); then
	die "invalid base port: $BASE_PORT"
fi

LAST_PORT=$((BASE_PORT + TABS - 1))
if ((LAST_PORT > 65535)); then
	die "port range ${BASE_PORT}-${LAST_PORT} exceeds 65535"
fi

if ((TABS > 1 && CONFIRM == 0)); then
	die "tabs=${TABS} requires --confirm (try --smoke / --tabs 1 first)"
fi

[[ -x "$SHELL_HELPER" ]] || die "missing executable: $SHELL_HELPER"
command -v nc >/dev/null 2>&1 || die "nc required"
command -v script >/dev/null 2>&1 || die "script(1) required"

task_label=""
if ((SMOKE)) || ((TABS == 1 && BASE_PORT == 4591)); then
	task_label="port-broadcast: smoke"
elif ((TABS == 6 && BASE_PORT == 4591)); then
	task_label="port-broadcast: 6 tabs"
else
	task_label=""
fi

echo "port-broadcast-launcher: Cursor integrated terminal (not GNOME)" >&2
echo "port-broadcast-launcher: tabs=${TABS} bind=${BIND} ports=${BASE_PORT}-${LAST_PORT}" >&2
for ((i = 0; i < TABS; i++)); do
	port=$((BASE_PORT + i))
	echo "  tab $((i + 1)): nc ${BIND} ${port}" >&2
	if ss -ltn "( sport = :$port )" 2>/dev/null | grep -q ":${port} "; then
		die "port ${port} already in use"
	fi
done

echo >&2
if [[ -n "$task_label" ]]; then
	echo "Open in Cursor (regular IDE terminal tabs):" >&2
	echo "  Command Palette → Tasks: Run Task → ${task_label}" >&2
else
	echo "No shipped task for tabs=${TABS} base=${BASE_PORT}." >&2
	echo "Open Cursor terminals manually and run:" >&2
	for ((i = 0; i < TABS; i++)); do
		port=$((BASE_PORT + i))
		echo "  ${SHELL_HELPER} -b ${BIND} -p ${port}" >&2
	done
fi

echo >&2
echo "Why not GNOME Terminal: that is a second OS terminal app; Cursor already has tabs." >&2

if ((DRY_RUN)); then
	echo "dry-run: no task invoked." >&2
fi

exit 0
