#!/usr/bin/env bash
# port-broadcast-launcher — one GNOME Terminal window, N tabs of port-broadcast-shell
#
# Austen watches the window; agents attach later with: nc 127.0.0.1 <port>
#
# Safety (machine previously hard-crashed on reckless multi-spawn):
#   - ONE gnome-terminal process (one --window + N --tab), never N windows
#   - Hard cap on tab count (8)
#   - Preflight: DISPLAY/dbus/gnome-terminal/script/nc/ports
#   - tabs>1 requires --confirm (use --smoke / --tabs 1 first)
#   - --dry-run prints argv + port map only
#
# Usage:
#   ./scripts/port-broadcast-launcher --smoke
#   ./scripts/port-broadcast-launcher --tabs 1
#   ./scripts/port-broadcast-launcher --tabs 6 --confirm
#   ./scripts/port-broadcast-launcher --tabs 6 --confirm -- dssh logs backend
#   ./scripts/port-broadcast-launcher --dry-run --tabs 6 --confirm

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SELF="${ROOT}/scripts/port-broadcast-launcher"
SHELL_HELPER="${ROOT}/scripts/port-broadcast-shell"
BIND="${PORT_BROADCAST_BIND:-127.0.0.1}"
BASE_PORT="${PORT_BROADCAST_BASE_PORT:-4591}"
TABS="${PORT_BROADCAST_TABS:-6}"
MAX_TABS=8
CONFIRM=0
DRY_RUN=0
SMOKE=0
CMD=()

usage() {
	cat <<'EOF'
Usage: port-broadcast-launcher [options] [-- command [args...]]

  Open ONE gnome-terminal window with N tabs. Each tab runs
  scripts/port-broadcast-shell on a distinct port (base, base+1, …).

Options:
  -n, --tabs N          Tab count (default: 6, or PORT_BROADCAST_TABS; max 8)
  -p, --base-port PORT  First listen port (default: 4591, or PORT_BROADCAST_BASE_PORT)
  -b, --bind ADDR       Listen address (default: 127.0.0.1, or PORT_BROADCAST_BIND)
      --confirm         Required when tabs > 1 (prevents accidental multi-spawn)
      --smoke           1-tab short-lived smoke (echo + sleep); implies --tabs 1
      --dry-run         Print gnome-terminal argv + port map; do not launch
  -h, --help            Show this help

  -- command ...        Passed to each tab's port-broadcast-shell after --
                        (same command in every tab; omit for interactive $SHELL)

Agent attach (after launch):
  nc 127.0.0.1 4591
  nc 127.0.0.1 4592
  …

Smoke first:
  ./scripts/port-broadcast-launcher --smoke
  # then: ./scripts/port-broadcast-launcher --tabs 6 --confirm
EOF
}

die() {
	echo "port-broadcast-launcher: $*" >&2
	exit 1
}

# Internal worker: gnome-terminal -e invokes this with a state dir + port.
# Avoids nested-quote hell through -e.
exec_tab() {
	local state_dir="" port="" bind="$BIND"
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--state)
				state_dir="${2:?}"
				shift 2
				;;
			-p|--port)
				port="${2:?}"
				shift 2
				;;
			-b|--bind)
				bind="${2:?}"
				shift 2
				;;
			*)
				die "exec-tab: unknown arg: $1"
				;;
		esac
	done
	[[ -n "$state_dir" && -n "$port" ]] || die "exec-tab requires --state DIR -p PORT"
	local -a extra=()
	if [[ -f "$state_dir/cmd" && -s "$state_dir/cmd" ]]; then
		# shellcheck disable=SC1090
		source "$state_dir/cmd"
		extra=("${PORT_BROADCAST_TAB_CMD[@]}")
	fi
	if ((${#extra[@]})); then
		exec "$SHELL_HELPER" -b "$bind" -p "$port" -- "${extra[@]}"
	fi
	exec "$SHELL_HELPER" -b "$bind" -p "$port"
}

if [[ "${1:-}" == "--exec-tab" ]]; then
	shift
	exec_tab "$@"
fi

while [[ $# -gt 0 ]]; do
	case "$1" in
		-n|--tabs)
			TABS="${2:?missing tab count}"
			shift 2
			;;
		-p|--base-port)
			BASE_PORT="${2:?missing base port}"
			shift 2
			;;
		-b|--bind)
			BIND="${2:?missing bind address}"
			shift 2
			;;
		--confirm)
			CONFIRM=1
			shift
			;;
		--smoke)
			SMOKE=1
			shift
			;;
		--dry-run)
			DRY_RUN=1
			shift
			;;
		-h|--help)
			usage
			exit 0
			;;
		--)
			shift
			CMD=("$@")
			break
			;;
		-*)
			die "unknown option: $1"
			;;
		*)
			die "unexpected argument: $1 (use -- before a command)"
			;;
	esac
done

if ((SMOKE)); then
	TABS=1
	CMD=(bash -c 'echo "port-broadcast smoke: tab1 ok"; tty; echo SMOKE_OK; sleep 45')
fi

if ! [[ "$TABS" =~ ^[0-9]+$ ]] || ((TABS < 1 || TABS > MAX_TABS)); then
	die "tabs must be 1..${MAX_TABS} (got: $TABS)"
fi

if ! [[ "$BASE_PORT" =~ ^[0-9]+$ ]] || ((BASE_PORT < 1 || BASE_PORT > 65535)); then
	die "invalid base port: $BASE_PORT"
fi

LAST_PORT=$((BASE_PORT + TABS - 1))
if ((LAST_PORT > 65535)); then
	die "port range ${BASE_PORT}-${LAST_PORT} exceeds 65535"
fi

if ((TABS > 1 && CONFIRM == 0 && DRY_RUN == 0)); then
	die "tabs=${TABS} requires --confirm (smoke with --smoke / --tabs 1 first)"
fi

[[ -x "$SHELL_HELPER" ]] || die "missing executable: $SHELL_HELPER"
[[ -x "$SELF" ]] || die "launcher not executable: $SELF"

if ((DRY_RUN == 0)); then
	[[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] || die "no DISPLAY/WAYLAND_DISPLAY (GUI session required)"
	command -v gnome-terminal >/dev/null 2>&1 || die "gnome-terminal required"
	command -v script >/dev/null 2>&1 || die "script(1) required"
	command -v nc >/dev/null 2>&1 || die "nc required"
	if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus" ]]; then
		export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
	fi
	[[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] || die "DBUS_SESSION_BUS_ADDRESS unset (no session bus)"
	if ! timeout 3 gdbus introspect --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus >/dev/null 2>&1; then
		die "session dbus not reachable (refuse GUI launch)"
	fi
fi

ports=()
echo "port-broadcast-launcher: window tabs=${TABS} bind=${BIND} ports=${BASE_PORT}-${LAST_PORT}" >&2
for ((i = 0; i < TABS; i++)); do
	port=$((BASE_PORT + i))
	ports+=("$port")
	echo "  tab $((i + 1)): nc ${BIND} ${port}" >&2
	if ((DRY_RUN == 0)); then
		if ss -ltn "( sport = :$port )" 2>/dev/null | grep -q ":${port} "; then
			die "port ${port} already in use"
		fi
	fi
done

# State dir: shared cmd array + per-tab single-path runners (gnome-terminal -e
# gets ONE executable path — no argv split / quote issues).
STATE_DIR=""
if ((DRY_RUN == 0)) || ((${#CMD[@]})); then
	STATE_DIR="$(mktemp -d /tmp/port-broadcast-launcher.XXXXXX)"
	if ((${#CMD[@]})); then
		{
			printf 'PORT_BROADCAST_TAB_CMD=('
			printf ' %q' "${CMD[@]}"
			printf ' )\n'
		} >"$STATE_DIR/cmd"
	else
		: >"$STATE_DIR/cmd"
	fi
fi

gt_args=(gnome-terminal --geometry=100x28 --role=port-broadcast-launcher)
for ((i = 0; i < TABS; i++)); do
	port="${ports[$i]}"
	title="pb:${port}"
	runner="${STATE_DIR:-/tmp/port-broadcast-launcher.dry}/run-${port}"
	if [[ -n "$STATE_DIR" ]]; then
		cat >"$runner" <<EOF
#!/usr/bin/env bash
exec $(printf '%q' "$SELF") --exec-tab --state $(printf '%q' "$STATE_DIR") -b $(printf '%q' "$BIND") -p $(printf '%q' "$port")
EOF
		chmod +x "$runner"
	fi
	if ((i == 0)); then
		gt_args+=(--window --title="$title" --working-directory="$ROOT" -e "$runner")
	else
		gt_args+=(--tab --title="$title" --working-directory="$ROOT" -e "$runner")
	fi
done

if ((DRY_RUN)); then
	echo "dry-run argv:" >&2
	printf '  %q' "${gt_args[@]}" >&2
	echo >&2
	[[ -n "$STATE_DIR" && -d "$STATE_DIR" ]] && rm -rf "$STATE_DIR"
	exit 0
fi

echo "port-broadcast-launcher: launching one window (${TABS} tab(s))…" >&2
"${gt_args[@]}"
echo "port-broadcast-launcher: launched. Attach with nc as listed above." >&2
echo "port-broadcast-launcher: state ${STATE_DIR}" >&2
